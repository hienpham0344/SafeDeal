# SafeDeal Monorepo Environment Template
# Copy per-package templates (blockchain/.env, backend/.env, frontend/.env) or export into your shell.
# Never commit populated secrets or real private keys.

# ==============================================================================
# BLOCKCHAIN (Foundry: local Anvil 31337 or Avalanche Fuji 43113)
# ==============================================================================
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113
# Provide DEPLOYER_PRIVATE_KEY via shell export at deploy time only
DEPLOYER_PRIVATE_KEY=
SNOWTRACE_API_KEY=

# ==============================================================================
# BACKEND (Rust safedeal-api / Axum + SQLx)
# ==============================================================================
# Environments: local | test | staging | prod (SPRING_PROFILES_ACTIVE alias also accepted)
APP_ENV=local
SERVER_PORT=8080
DATABASE_URL=postgres://safedeal:safedeal@localhost:5432/safedeal
DB_USERNAME=safedeal
DB_PASSWORD=safedeal

JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-chars
SESSION_TTL_SECONDS=86400
NONCE_TTL_SECONDS=300
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
SESSION_COOKIE_NAME=safedeal_session
CSRF_COOKIE_NAME=safedeal_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set BLOCKCHAIN_SYNC_ENABLED=true and ESCROW_CONTRACT_ADDRESS after running scripts/deploy-local.sh
BLOCKCHAIN_SYNC_ENABLED=false
CHAIN_ID=31337
CHAIN_NAME=Anvil Local
AVALANCHE_RPC_URL=http://127.0.0.1:8545
ESCROW_CONTRACT_ADDRESS=
ESCROW_DEPLOYMENT_BLOCK=0
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=1
BLOCKCHAIN_SYNC_BATCH_SIZE=1000
BLOCKCHAIN_POLL_INTERVAL_MS=10000
BLOCKCHAIN_RPC_TIMEOUT_MS=10000

EVIDENCE_STORAGE_DIR=./storage/evidence
EVIDENCE_MAX_BYTES=5242880
EVIDENCE_MAX_REQUEST_BYTES=6291456
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30

# ==============================================================================
# FRONTEND (React + Vite)
# ==============================================================================
VITE_APP_NAME=SafeDeal
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8080
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Anvil Local
VITE_RPC_URL=http://127.0.0.1:8545
VITE_EXPLORER_BASE_URL=
VITE_ESCROW_CONTRACT_ADDRESS=
VITE_DEFAULT_ARBITER_ADDRESS=
VITE_DEFAULT_INSPECTION_WINDOW_SECONDS=259200
VITE_MAX_EVIDENCE_BYTES=5242880
VITE_TX_POLL_INTERVAL_MS=2000
VITE_HERO_VIDEO_URL=https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260622_204221_5339e40b-e73d-4ab0-9c65-79c18c66fd50.mp4
