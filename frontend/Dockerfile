# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html tsconfig.json vite.config.ts tailwind.config.js postcss.config.js ./
COPY public ./public
COPY src ./src

ARG VITE_APP_NAME=SafeDeal
ARG VITE_APP_ENV=docker
ARG VITE_API_BASE_URL=http://localhost:8080
ARG VITE_CHAIN_ID=31337
ARG VITE_CHAIN_NAME="Anvil Local"
ARG VITE_RPC_URL=http://127.0.0.1:8545
ARG VITE_EXPLORER_BASE_URL=
ARG VITE_ESCROW_CONTRACT_ADDRESS=
ARG VITE_DEFAULT_ARBITER_ADDRESS=
ARG VITE_DEFAULT_INSPECTION_WINDOW_SECONDS=259200
ARG VITE_MAX_EVIDENCE_BYTES=5242880
ARG VITE_TX_POLL_INTERVAL_MS=2000

ENV VITE_APP_NAME=$VITE_APP_NAME \
    VITE_APP_ENV=$VITE_APP_ENV \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_CHAIN_ID=$VITE_CHAIN_ID \
    VITE_CHAIN_NAME=$VITE_CHAIN_NAME \
    VITE_RPC_URL=$VITE_RPC_URL \
    VITE_EXPLORER_BASE_URL=$VITE_EXPLORER_BASE_URL \
    VITE_ESCROW_CONTRACT_ADDRESS=$VITE_ESCROW_CONTRACT_ADDRESS \
    VITE_DEFAULT_ARBITER_ADDRESS=$VITE_DEFAULT_ARBITER_ADDRESS \
    VITE_DEFAULT_INSPECTION_WINDOW_SECONDS=$VITE_DEFAULT_INSPECTION_WINDOW_SECONDS \
    VITE_MAX_EVIDENCE_BYTES=$VITE_MAX_EVIDENCE_BYTES \
    VITE_TX_POLL_INTERVAL_MS=$VITE_TX_POLL_INTERVAL_MS

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
