# Copy to frontend/.env for local execution. Never commit real secrets.
VITE_APP_NAME=SafeDeal
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8080

# Local Anvil: 31337 | Avalanche Fuji C-Chain Testnet: 43113
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Anvil Local
VITE_RPC_URL=http://127.0.0.1:8545
VITE_EXPLORER_BASE_URL=

# Populate with your deployed SafeDealEscrow address before creating deals
VITE_ESCROW_CONTRACT_ADDRESS=
VITE_DEFAULT_ARBITER_ADDRESS=

# Escrow & Evidence Policy
VITE_DEFAULT_INSPECTION_WINDOW_SECONDS=259200
VITE_MAX_EVIDENCE_BYTES=5242880
VITE_TX_POLL_INTERVAL_MS=2000

# Immutable hero video URL (override only if self-hosting identical visual asset)
VITE_HERO_VIDEO_URL=https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260622_204221_5339e40b-e73d-4ab0-9c65-79c18c66fd50.mp4
