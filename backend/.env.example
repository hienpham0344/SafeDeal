# Copy to backend/.env for local execution. Never commit real secrets.
# Environments: local | test | staging | prod (SPRING_PROFILES_ACTIVE is also accepted)
APP_ENV=local
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL Datasource (local defaults to postgres://safedeal:safedeal@localhost:5432/safedeal)
# Either DATABASE_URL or DB_URL (+ optional DB_USERNAME/DB_PASSWORD) is supported.
DATABASE_URL=postgres://safedeal:safedeal@localhost:5432/safedeal
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MIN_CONNECTIONS=2
DB_ACQUIRE_TIMEOUT_MS=5000

# Authentication / Session / CSRF
# Production & staging require >= 32 characters without placeholder words (replace-with, change-me, dev-only, example)
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-chars
SESSION_TTL_SECONDS=86400
NONCE_TTL_SECONDS=300
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
SESSION_COOKIE_NAME=safedeal_session
CSRF_COOKIE_NAME=safedeal_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS (comma-separated allowed origins; wildcard '*' is rejected)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Avalanche / EVM Blockchain
# Set BLOCKCHAIN_SYNC_ENABLED=true and ESCROW_CONTRACT_ADDRESS after running scripts/deploy-local.sh
BLOCKCHAIN_SYNC_ENABLED=false
CHAIN_ID=31337
CHAIN_NAME=Anvil Local
AVALANCHE_RPC_URL=http://127.0.0.1:8545
ESCROW_CONTRACT_ADDRESS=
ESCROW_DEPLOYMENT_BLOCK=0
BLOCKCHAIN_CONFIRMATIONS_REQUIRED=1
BLOCKCHAIN_SYNC_BATCH_SIZE=1000
BLOCKCHAIN_POLL_INTERVAL_MS=10000
BLOCKCHAIN_RPC_TIMEOUT_MS=10000

# Evidence Storage
EVIDENCE_STORAGE_DIR=./storage/evidence
EVIDENCE_MAX_BYTES=5242880
EVIDENCE_MAX_REQUEST_BYTES=6291456

# Auth Rate Limiting
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30

# OpenAPI / Swagger UI (disabled automatically in prod/staging unless explicitly set true)
SWAGGER_UI_ENABLED=true
API_DOCS_ENABLED=true
