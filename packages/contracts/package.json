{
  "name": "@safedeal/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SafeDeal escrow, subscription and dispute smart contracts (Avalanche Fuji)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "abi:export": "node scripts/export-abi.mjs",
    "ignition:deploy:fuji": "hardhat ignition deploy ignition/modules/SafeDeal.ts --network fuji",
    "ignition:deploy:local": "hardhat ignition deploy ignition/modules/SafeDeal.ts --network localhost",
    "build": "npm run compile && npm run abi:export"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "3.1.9",
    "@nomicfoundation/hardhat-ignition-viem": "3.1.6",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.2",
    "@nomicfoundation/hardhat-viem": "3.1.0",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.5",
    "@nomicfoundation/ignition-core": "3.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "3.21.2",
    "typescript": "5.9.3",
    "viem": "2.57.16"
  }
}
