# Copy values into your shell or IDE run configuration. Never commit real values.
# Spring profile: dev (default) or prod
SPRING_PROFILES_ACTIVE=dev

# Option A: individual variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safedeal
DB_USERNAME=
DB_PASSWORD=
# prod only: disable|require|verify-full (Railway public proxy needs require)
DB_SSLMODE=require

# Option B: full JDBC URL (takes precedence over DB_HOST/DB_PORT/DB_NAME)
# Convert Railway's DATABASE_URL (postgresql://user:pass@host:port/db) as described in docs/railway-postgres.md
DATABASE_JDBC_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI (provider "mock" needs nothing else)
AI_PROVIDER=mock
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=

# Avalanche Fuji
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
BLOCKCHAIN_CONFIRMATIONS=2
ESCROW_MANAGER_ADDRESS=
SUBSCRIPTION_MANAGER_ADDRESS=
DISPUTE_RESOLVER_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
