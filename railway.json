{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "java -jar target/safedeal-api-0.1.0-SNAPSHOT.jar",
    "restartPolicyMaxRetries": 5,
    "healthchecks": {
      "liveness": {
        "initialDelaySeconds": 30,
        "periodSeconds": 30,
        "timeoutSeconds": 10,
        "failureThreshold": 3,
        "command": ["curl", "-f", "http://localhost:8080/actuator/health/live"]
      },
      "readiness": {
        "initialDelaySeconds": 15,
        "periodSeconds": 10,
        "timeoutSeconds": 5,
        "failureThreshold": 3,
        "command": ["curl", "-f", "http://localhost:8080/actuator/health/ready"]
      }
    }
  }
}
